# Local development only
DB_URL=jdbc:postgresql://localhost:15434/expo_attention
DB_USERNAME=expo_attention
DB_PASSWORD=expo-attention-local-only
EUREKA_CLIENT_ENABLED=false
# Shared secret for service-to-service calls (X-Internal-Token), at least 32 characters.
# Generate one locally: openssl rand -base64 32. Never commit a real value.
INTERNAL_TOKEN=
# Tokens sent to the other services (X-Internal-Token); each must equal that service's own INTERNAL_TOKEN, at least 32 characters.
USER_INTERNAL_TOKEN=
EXPO_INTERNAL_TOKEN=
APPLICATION_INTERNAL_TOKEN=
# Optional: call the services directly (local development without Eureka), e.g. http://localhost:8080
USER_URL=
EXPO_URL=
APPLICATION_URL=

# Optional tuning (defaults shown). Leave unset to use the defaults.
# Minutes before a session starts that a pre-registered QR may enter.
# PREREGISTER_ENTRY_LEAD_MINUTES=30
# Seconds a scanner user may re-scan the same QR and get the first response (0 turns it off).
# ENTRY_RETRY_WINDOW_SECONDS=300
# Require the participant code on standard program scans (turn on once the client sends it).
# PROGRAM_ATTENDANCE_REQUIRE_CODE=false
# Re-check paper QR entries recorded while the expo service was down.
# QR_ENTRY_REVIEW_ENABLED=true
# QR_ENTRY_REVIEW_INTERVAL_MS=300000
